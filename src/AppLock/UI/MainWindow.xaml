<Window x:Class="AppLock.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="アプリロック"
        Width="620" Height="780" MinWidth="480" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Language="ja-JP"
        FontFamily="{StaticResource UiFont}"
        Icon="/Assets/AppLock.ico">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <StackPanel Margin="28,20,28,28">

            <!-- いまの状態 -->
            <Border Style="{StaticResource Card}" Padding="16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="44" Height="44" CornerRadius="10" Background="{StaticResource LockBrush}" VerticalAlignment="Center">
                        <TextBlock x:Name="HeaderGlyph" Style="{StaticResource Glyph}" Text="&#xE72E;" FontSize="20" Foreground="White" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                        <TextBlock x:Name="Headline" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock x:Name="Subline" Style="{StaticResource Caption}" FontSize="13" Margin="0,2,0,0"
                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Button x:Name="RelockAllButton" Grid.Column="2" Content="すべてロック" VerticalAlignment="Center"
                            ToolTip="解除中のアプリをロックし直します" Click="OnRelockAll" />
                </Grid>
            </Border>

            <!-- 設定の変更に認証が要るとき -->
            <Border x:Name="AuthBanner" Style="{StaticResource Card}" Margin="0,12,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE72E;" Foreground="{StaticResource LockBrush}" Margin="0,0,12,0" />
                    <TextBlock Grid.Column="1" Style="{StaticResource Body}" VerticalAlignment="Center"
                               Text="アプリロックの設定を変更するには、認証が必要です。" />
                    <Button Grid.Column="2" Content="認証…" Style="{DynamicResource AccentButtonStyle}" Margin="12,0,0,0"
                            VerticalAlignment="Center" Click="OnAuthenticate" />
                </Grid>
            </Border>

            <!-- Windows Hello が使えないとき -->
            <Border x:Name="HelloBanner" Style="{StaticResource Card}" Margin="0,12,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE946;" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                               Margin="0,2,12,0" VerticalAlignment="Top" />
                    <StackPanel Grid.Column="1">
                        <TextBlock x:Name="HelloTitle" Style="{StaticResource Body}" FontWeight="SemiBold" />
                        <TextBlock x:Name="HelloText" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                        <Button x:Name="HelloButton" Content="サインイン オプションを開く" HorizontalAlignment="Left" Margin="0,10,0,2"
                                Click="OnOpenSignInOptions" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ロックするアプリ -->
            <Grid Margin="0,24,0,8">
                <TextBlock Text="ロックするアプリ" Style="{StaticResource SectionHeader}" Margin="2,0,0,0" VerticalAlignment="Center" />
                <Button x:Name="AddButton" HorizontalAlignment="Right" Click="OnAddApps" AutomationProperties.Name="アプリを追加">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE710;" FontSize="12" Margin="0,0,8,0" />
                        <TextBlock Text="アプリを追加…" />
                    </StackPanel>
                </Button>
            </Grid>
            <Border Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <ItemsControl x:Name="AppsList" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <Border Style="{StaticResource Divider}" Visibility="{Binding DividerVisibility}" />
                                    <Grid Margin="16,10,10,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="32" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource Glyph}" Text="&#xECAA;" FontSize="22"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   Visibility="{Binding FallbackVisibility}" />
                                        <Image Source="{Binding Icon}" Width="32" Height="32" VerticalAlignment="Center"
                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                        <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource Body}" TextWrapping="NoWrap"
                                                       TextTrimming="CharacterEllipsis" />
                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                <TextBlock Style="{StaticResource Glyph}" FontSize="11" Text="{Binding StateGlyph}"
                                                           Foreground="{Binding StateBrush}" Margin="0,1,6,0" />
                                                <TextBlock Text="{Binding StateText}" Style="{StaticResource Caption}" />
                                            </StackPanel>
                                        </StackPanel>
                                        <Button Grid.Column="2" Content="開く" Margin="0,0,4,0" VerticalAlignment="Center"
                                                Tag="{Binding}" Click="OnOpenApp" />
                                        <Button Grid.Column="3" Style="{StaticResource IconButton}" Content="&#xE74D;"
                                                ToolTip="ロックをやめる" AutomationProperties.Name="{Binding RemoveLabel}"
                                                IsEnabled="{Binding CanEdit}" Tag="{Binding}" Click="OnRemoveApp" />
                                    </Grid>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel x:Name="EmptyState" Margin="24,28" HorizontalAlignment="Center">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE72E;" FontSize="28" Foreground="{StaticResource LockBrush}" />
                        <TextBlock Text="ロックするアプリはありません" Style="{StaticResource Body}" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" Margin="0,12,0,4" />
                        <TextBlock x:Name="EmptyText" Style="{StaticResource Caption}"
                                   HorizontalAlignment="Center" TextAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ロックの設定 -->
            <TextBlock Text="ロックの設定" Style="{StaticResource SectionHeader}" />
            <Border Style="{StaticResource Card}" Padding="16,4">
                <StackPanel>
                    <Grid Style="{StaticResource SettingRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="ロックし直す" Style="{StaticResource Body}" />
                            <TextBlock x:Name="RelockNote" Style="{StaticResource Caption}" Margin="0,2,0,0"
                                       Text="PC がスリープまたはロックしたときも、ロックし直します。" />
                        </StackPanel>
                        <ComboBox x:Name="RelockRuleBox" Grid.Column="1" MinWidth="230" VerticalAlignment="Center"
                                  SelectionChanged="OnRelockRuleChanged">
                            <ComboBoxItem Content="アプリを終了したとき" />
                            <ComboBoxItem Content="一定時間がたったとき" />
                            <ComboBoxItem Content="ほかのアプリに切り替えたとき" />
                        </ComboBox>
                    </Grid>
                    <Grid x:Name="MinutesRow" Style="{StaticResource SettingRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="ロックし直すまで" Style="{StaticResource Body}" VerticalAlignment="Center" />
                        <ComboBox x:Name="MinutesBox" Grid.Column="1" MinWidth="120" VerticalAlignment="Center"
                                  SelectionChanged="OnMinutesChanged" />
                    </Grid>
                    <Border Style="{StaticResource Divider}" Margin="-16,4" />
                    <Grid Style="{StaticResource SettingRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="認証できなかったときはアプリを終了" Style="{StaticResource Body}" VerticalAlignment="Center" Margin="0,0,16,0" />
                        <CheckBox x:Name="QuitOnFailureBox" Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                  AutomationProperties.Name="認証できなかったときはアプリを終了" Click="OnQuitOnFailureChanged" />
                    </Grid>
                    <Border Style="{StaticResource Divider}" Margin="-16,4" />
                    <Grid Style="{StaticResource SettingRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="設定の変更とアプリロックの終了に認証を要求" Style="{StaticResource Body}" VerticalAlignment="Center" Margin="0,0,16,0" />
                        <CheckBox x:Name="ProtectSelfBox" Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                  AutomationProperties.Name="設定の変更とアプリロックの終了に認証を要求" Click="OnProtectSelfChanged" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 全般 -->
            <TextBlock Text="全般" Style="{StaticResource SectionHeader}" />
            <Border Style="{StaticResource Card}" Padding="16,4">
                <Grid Style="{StaticResource SettingRow}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="サインイン時に開始" Style="{StaticResource Body}" />
                        <TextBlock Text="アプリロックが動いていないときは、アプリはロックされません。" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                    </StackPanel>
                    <CheckBox x:Name="StartupBox" Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                              AutomationProperties.Name="サインイン時に開始" Click="OnStartupChanged" />
                </Grid>
            </Border>

            <TextBlock x:Name="VersionText" Style="{StaticResource Caption}" Margin="2,20,0,0" />
        </StackPanel>
    </ScrollViewer>
</Window>
