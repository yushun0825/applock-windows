<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>AppLock</RootNamespace>
    <AssemblyName>AppLock</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\AppLock.ico</ApplicationIcon>
    <!-- ThemeMode(Windows 11 の見た目)はまだ試験的な API -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
    <SatelliteResourceLanguages>ja</SatelliteResourceLanguages>
    <!-- 常駐する小さなアプリなので、GC は裏のスレッドを使わない -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <InvariantGlobalization>false</InvariantGlobalization>
    <Title>アプリロック</Title>
    <Description>選んだアプリを、開くときに Windows Hello で確かめる</Description>
  </PropertyGroup>

  <!-- 確かめるための組み立て(偽の認証・別の設定の場所)。公開する版には入れない -->
  <PropertyGroup Condition="'$(AppLockTesting)' == 'true'">
    <DefineConstants>$(DefineConstants);APPLOCK_TESTING</DefineConstants>
  </PropertyGroup>

  <!-- 配る形: 1 つの実行ファイルに .NET ごと入れる(入れる PC に .NET が無くても動く) -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- 圧縮しない: 部品をファイルから直接読むので、使うメモリが少なくて済む(配るときは zip で縮める) -->
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AppLock.Core\AppLock.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\AppLock.ico" />
    <None Include="uninstall.ps1" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
